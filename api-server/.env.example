# GEOPÓLEM API v1 (Sprint 3) — variables de entorno de ejemplo.
# Copia este archivo a `.env` y ajústalo. SIN DATABASE_URL el servidor arranca
# igual y sirve desde el puente estático JSON (api/v1/*.json). No comitear `.env`.

# --- Servidor ---
PORT=8787
HOST=0.0.0.0
# Origen CORS permitido. '*' para desarrollo; restríngelo en producción,
# p. ej. CORS_ORIGIN=https://geopolem.com
CORS_ORIGIN=*

# --- PostgreSQL / PostGIS (opcional) ---
# Déjalo vacío o sin definir para usar el fallback estático.
# Formato: postgres://usuario:password@host:puerto/base
# DATABASE_URL=postgres://geopolem:geopolem@localhost:5432/geopolem
# SSL para proveedores gestionados (Render/Supabase/Neon):
# PG_SSL=true
PG_POOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=5000
PG_CONNECT_TIMEOUT_MS=4000

# --- Paginación (contrato v1) ---
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# --- Autenticación JWT (Sprint 5) ---
# Modo de auth: public (por defecto, sin auth — no rompe PWA/GitHub Pages),
# optional (valida token si viene), required (exige Bearer token válido).
# /api/v1/health SIEMPRE queda público.
GEOP_API_AUTH_MODE=public
# Secreto HS256. OBLIGATORIO si el modo != public. NUNCA comitear el real.
# JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
# Holgura de reloj (segundos) para exp/nbf.
JWT_LEEWAY_SEC=30
# Emisor/audiencia esperados (opcionales; si se definen, se validan).
# JWT_ISSUER=geopolem
# JWT_AUDIENCE=geopolem-api
# Secreto HS256 ANTERIOR aceptado durante una ventana de rotación (Sprint 7).
# Ver docs/jwt-rotation.md. Déjalo vacío fuera de rotaciones.
# JWT_SECRET_PREVIOUS=

# --- Observabilidad de meta.source (Sprint 5) ---
# Emite una línea JSON por respuesta con el origen (database|static|error).
# Los contadores acumulados se exponen en GET /api/v1/health.
GEOP_OBS_LOG=true

# --- Métricas Prometheus (Sprint 6) ---
# Expone GET /api/v1/metrics en formato Prometheus (siempre público, como health).
GEOP_METRICS_ENABLED=true

# --- Rate limiting simple (Sprint 6) ---
# Ventana fija en memoria. 0 = desactivado (no afecta al modo public por defecto).
# /health y /metrics quedan siempre exentos.
GEOP_RATE_LIMIT_MAX=0
GEOP_RATE_LIMIT_WINDOW_MS=60000

# --- Scopes/roles JWT (Sprint 6) ---
# Lectura pública: vacío = los endpoints de lectura NO exigen scope (por defecto).
# CMS/Admin (Sprint 7): scopes preparados para /api/v1/cms y /api/v1/admin.
GEOP_SCOPE_READ=
GEOP_SCOPE_CMS=cms:write
GEOP_SCOPE_ADMIN=admin

# --- CMS/Admin API (Sprint 7; endurecido en Sprint 9) ---
# Los endpoints /api/v1/admin/* y /api/v1/cms/* SIEMPRE exigen token+scope,
# incluso en GEOP_API_AUTH_MODE=public. La lectura pública no cambia.
# Persistencia de escrituras (política fail-closed de Sprint 9):
#   false = modo "prepared" (valida el contrato pero NO escribe; no inventa
#           datos). Respuesta 200 meta.persisted=false. Es el valor por defecto.
#   true  = escribe realmente. REQUIERE DATABASE_URL alcanzable. Si se activa
#           sin DATABASE_URL o con la DB inalcanzable, la API responde 503
#           service_unavailable (NO finge un guardado). Sólo con DB viva persiste
#           (INSERT/UPDATE parametrizados) usando id/UUID reales del esquema.
GEOP_ADMIN_WRITES=false
