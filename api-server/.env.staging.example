# GEOPÓLEM API v1 — variables de entorno para STAGING (Sprint 4).
# ---------------------------------------------------------------------------
# Copia este archivo a `.env` (o configura las variables en el panel del
# proveedor) y ajústalo. NUNCA comitees el `.env` con credenciales reales.
# Este fichero NO contiene secretos: los valores de DATABASE_URL de ejemplo
# son placeholders y deben reemplazarse en el entorno del proveedor.
#
# Regla de oro (arquitectura reversible por capas):
#   1) API real PostgreSQL/PostGIS  →  2) JSON estático /api/v1/*.json  →
#   3) data.js / FOCOS local (en el navegador).
# Sin DATABASE_URL el servidor arranca igual y sirve desde el puente estático.
# ---------------------------------------------------------------------------

# --- Servidor ---
PORT=8787
HOST=0.0.0.0

# CORS: en staging restríngelo al origen del frontend de staging.
# Producción: CORS_ORIGIN=https://geopolem.com
CORS_ORIGIN=https://mdiaznaranjo-a11y.github.io

# --- PostgreSQL / PostGIS (staging gestionado o local) ---
# Formato: postgres://usuario:password@host:puerto/base
# Déjalo vacío para forzar el modo fallback estático (útil para smoke sin DB).
#
# Ejemplos por proveedor (reemplaza credenciales en el entorno, no aquí):
#   Neon:      postgres://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/geopolem?sslmode=require
#   Supabase:  postgres://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
#   Render:    postgres://USER:PASSWORD@dpg-xxx-a.frankfurt-postgres.render.com/geopolem
#   Railway:   postgres://postgres:PASSWORD@containers-us-west-xxx.railway.app:5432/railway
#   Fly.io:    postgres://postgres:PASSWORD@geopolem-db.internal:5432/geopolem
#   Local:     postgres://geopolem:geopolem@localhost:5432/geopolem
DATABASE_URL=

# SSL: obligatorio en la mayoría de proveedores gestionados (Neon/Supabase/Render).
# Para PostgreSQL local (docker-compose) déjalo en false.
PG_SSL=true

# Pool y timeouts (ajusta al plan del proveedor).
PG_POOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=5000
PG_CONNECT_TIMEOUT_MS=4000

# --- Paginación (contrato v1) ---
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# --- Autenticación JWT (Sprint 5) ---
# En staging se recomienda 'optional' para probar tokens SIN romper el acceso
# público de la PWA. Promocionar a 'required' sólo cuando el frontend ya envíe
# el Bearer token. /api/v1/health SIEMPRE queda público.
GEOP_API_AUTH_MODE=optional
# Secreto HS256: DEFINIR EN EL PANEL DEL PROVEEDOR, nunca en este archivo.
# JWT_SECRET=  (secreto real inyectado por el entorno)
JWT_LEEWAY_SEC=30
# JWT_ISSUER=geopolem
# JWT_AUDIENCE=geopolem-api

# --- Observabilidad de meta.source (Sprint 5) ---
# Mantener ON en staging: los logs JSON y los contadores de /api/v1/health
# permiten decidir la promoción staging→producción (database_ratio ~1.0).
GEOP_OBS_LOG=true

# --- Métricas Prometheus (Sprint 6) ---
# Exponer GET /api/v1/metrics para el recolector (Prometheus/OTel). Público,
# igual que /health. Úsalo con staging-verify.mjs para decidir GO/NO-GO.
GEOP_METRICS_ENABLED=true

# --- Rate limiting simple (Sprint 6) ---
# En staging con auth 'optional' puede dejarse en 0 (off). Al promover a
# 'required' conviene activarlo para endurecer los endpoints protegidos.
# /health y /metrics quedan siempre exentos.
GEOP_RATE_LIMIT_MAX=0
GEOP_RATE_LIMIT_WINDOW_MS=60000

# --- Scopes/roles JWT (Sprint 6) ---
# Lectura pública sin scope por defecto. Prepara CMS/Admin para Sprint 7.
GEOP_SCOPE_READ=
GEOP_SCOPE_CMS=cms:write
GEOP_SCOPE_ADMIN=admin

# ---------------------------------------------------------------------------
# ACTIVACIÓN DEL FRONTEND (no son variables de este servidor Node).
# Se definen en el navegador, antes de cargar app.js, mediante window.*.
# El servidor las expone aquí sólo como documentación de referencia:
#
#   GEOP_USE_API   → activa el consumo de la API real desde el frontend.
#                    Por defecto FALSE (el sitio se comporta como hoy).
#                    En staging: true. En producción: sólo con autorización.
#   GEOP_API_BASE  → host de este api-server, p.ej. https://staging-api.geopolem.com
#   GEOP_API_MODE  → alias documental del modo de datos del frontend:
#                    'static' (por defecto) | 'api' (equivale a GEOP_USE_API=true).
#   GEOP_CONFLICTS_STATIC → respaldo estático si la API cae (./api/v1/conflicts.json).
#
# Ver SPRINT_4_STAGING_POSTGRES.md → «Activación controlada del frontend».
# ---------------------------------------------------------------------------
